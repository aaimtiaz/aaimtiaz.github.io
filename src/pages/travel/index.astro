---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import { getEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import TravelMap from '../../components/TravelMap.astro';
import { getPublished, byDateDesc } from '../../lib/content';
import { MODES, type Mode } from '../../data/places';

const all = (await getPublished('travel')).sort(byDateDesc);

const byMode = new Map<Mode, number>();
for (const e of all) if (e.data.mode) byMode.set(e.data.mode, (byMode.get(e.data.mode) ?? 0) + 1);

const page = await getEntry('pages', 'travel');
const layout = page!.data.layout ?? [];
---
<Base
  title="Travel"
  description="Where I have been — mountains, islands, tea gardens and a lot of kilometres by bicycle, mapped."
>
  <div class="wrap">
    <h1 data-edit="pages/travel.md#title">Travel</h1>
    <Sections sections={layout} file="pages/travel.md">
      <Fragment slot="entries">

    {all.length === 0 ? (
      <p class="empty-state">No travel posts published yet.</p>
    ) : (
      <>
        <TravelMap entries={all} />

        {byMode.size > 0 && (
          <ul class="modes" aria-label="How the trips were made">
            {[...byMode.entries()].sort((a, b) => b[1] - a[1]).map(([m, n]) => (
              <li><span>{MODES[m].label}</span> <b>{n}</b></li>
            ))}
          </ul>
        )}

        <h2 class="section-label">All trips</h2>
        <div class="grid grid--3up">
          {all.map((e) => (
            <PostCard href={`/travel/${e.id}/`} data={e.data}
                      kind={e.data.mode ? MODES[e.data.mode].label : e.data.location?.name} />
          ))}
        </div>
      </>
    )}
      </Fragment>
    </Sections>
  </div>
</Base>

<style>
  .lede { font-size: var(--step-1); color: var(--text-muted); margin-block: var(--space-4) var(--space-7); max-width: var(--measure); }

  .modes {
    list-style: none; padding: 0; margin-block-end: var(--space-10);
    display: flex; flex-wrap: wrap; gap: var(--space-2);
  }
  .modes li {
    display: inline-flex; align-items: baseline; gap: var(--space-2);
    padding: 0.2em 0.7em;
    border: 1px solid var(--border); border-radius: 999px;
    font-size: var(--step--1); color: var(--text-muted);
  }
  .modes b { color: var(--accent); }

  .grid--3up { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 60rem) { .grid--3up { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 38rem) { .grid--3up { grid-template-columns: minmax(0, 1fr); } }
</style>
